            "required": [
              "window"
            ]
          },
          {
            "properties": {
              "panel": true
            },
            "required": [
              "panel"
            ]
          }
        ]
      },
      "properties": {
        "commands": true,
        "permissions": {
          "not": {
            "contains": {
              "enum": [
                "ui.window",
                "ui.panel",
                "speech.speak",
                "timer.control",
                "clipboard.history.read",
                "clipboard.history.paste",
                "clipboard.history.copy"
