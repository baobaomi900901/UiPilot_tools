    "PluginNetworkCredential": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9.-]{0,63}$",
          "type": "string"
        },
        "settingKey": {
          "pattern": "^[a-z][a-z0-9.-]{0,63}$",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/PluginNetworkCredentialType"
        }
      },
      "required": [
        "id",
        "settingKey",
        "host",
        "type"
      ],
      "type": "object"
    },
    "PluginNetworkCredentialType": {
      "enum": [
        "bearer"
      ],
      "type": "string"
    },
    "PublicActivationMode": {
      "enum": [
        "live",
        "submit"
      ],
      "type": "string"
    },
    "PublicCommandV1": {
      "additionalProperties": false,
