      "properties": {
        "command": true
      },
      "required": [
        "command"
      ]
    },
    {
      "not": {
        "anyOf": [
          {
            "properties": {
              "command": true
            },
            "required": [
              "command"
            ]
          },
          {
            "properties": {
              "window": true
