            "type": {
              "const": "number",
              "type": "string"
            }
          },
          "required": [
            "type",
            "key",
            "label"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "default": {
              "default": null,
              "type": [
                "boolean",
                "null"
