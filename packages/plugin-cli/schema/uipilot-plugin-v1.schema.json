    "PublicShareReceiverV1": {
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "const": "default"
        },
        "id": {
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          },
          "pattern": "^[a-z][a-z0-9.-]{0,63}$",
          "type": "string"
        },
        "maxBytes": {
          "format": "uint32",
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]*$",
          "type": "string"
        },
        "types": {
          "const": [
            "text/plain"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "commandId",
        "types",
        "maxBytes"
      ],
      "type": "object"
