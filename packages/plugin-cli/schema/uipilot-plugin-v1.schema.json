    "PublicNetworkV1": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "items": {
            "$ref": "#/$defs/PluginNetworkCredential"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "httpsHosts": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "httpsHosts"
      ],
      "type": "object"
    },
    "PublicOutputMode": {
      "enum": [
        "mainResult",
        "window",
        "panel"
      ],
      "type": "string"
    },
    "PublicPanelV1": {
