{
  "$defs": {
    "PanelHostKeyDeclaration": {
      "enum": [
        "ArrowDown",
        "ArrowUp",
        "Primary+N",
        "Tab",
        "Shift+Tab",
        "Enter",
        "Delete"
      ],
      "type": "string"
    },
    "PanelHostKeyFocus": {
      "enum": [
