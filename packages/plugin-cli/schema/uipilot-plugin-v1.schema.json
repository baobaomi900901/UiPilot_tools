          ]
        }
      },
      "required": [
        "defaultName",
        "activationMode",
        "outputMode",
        "inputRequired"
      ],
      "type": "object"
    },
    "PublicInputCapability": {
      "enum": [
        "image.ocr"
      ],
      "type": "string"
    },
    "PublicNamedCommandV1": {
      "additionalProperties": false,
      "properties": {
        "activationMode": {
          "$ref": "#/$defs/PublicActivationMode"
        },
        "defaultName": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "type": "string"
