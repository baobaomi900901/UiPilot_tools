{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-multi",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.5.0",
  "name": "Public Plugin Demo Multi",
  "description": "Two text commands sharing one offline Runtime and package data.",
  "supportedPlatforms": [
    "windows",
    "macos"
  ],
  "commands": [
    {
      "id": "upper",
      "defaultName": "demo-upper",
      "summary": "Convert text to uppercase",
      "activationMode": "live",
      "outputMode": "mainResult",
      "inputRequired": true,
      "inputPlaceholder": "Enter text"
    },
    {
      "id": "lower",
      "defaultName": "demo-lower",
      "summary": "Convert text to lowercase",
      "activationMode": "submit",
      "outputMode": "mainResult",
      "inputRequired": true,
      "inputPlaceholder": "Enter text"
    }
  ],
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "permissions": [
    "clipboard.write"
  ],
  "settings": [
    {
      "type": "text",
      "key": "prefix",
      "label": "Result prefix",
      "default": "[demo] "
    }
  ]
}
