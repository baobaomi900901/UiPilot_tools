{
 "schemaVersion": 1, "pluginId": "com.uipilot.ocr", "version": "1.1.0", "apiVersion": 1,
 "share": { "version": 1, "source": true },
 "minimumHostVersion": "0.22.0", "name": "ocr", "description": "在面板中识别图片、编辑并复制完整文字。",
 "supportedPlatforms": ["windows"],
