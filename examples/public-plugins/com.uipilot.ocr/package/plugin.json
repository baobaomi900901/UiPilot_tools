 "runtime": { "entry": "dist/runtime.js" },
 "panel": { "entry": "dist/panel.html", "runtimeActions": true, "hostKeys": ["Enter", "Tab", "Shift+Tab"], "hostKeyFocus": "content" },
 "permissions": ["ui.panel", "clipboard.write", "credentials.baiduOcr", "network.https"],
 "network": { "httpsHosts": ["aip.baidubce.com"] }, "settings": []
}
