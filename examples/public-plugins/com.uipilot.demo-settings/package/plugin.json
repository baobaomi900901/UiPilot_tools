{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-settings",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.2.0",
  "name": "普通设置示例",
  "description": "离线读取四类普通设置，在主界面直接核对当前值。",
  "supportedPlatforms": ["windows", "macos"],
  "command": {
    "defaultName": "settings-demo",
    "summary": "查看当前普通设置",
    "activationMode": "submit",
    "outputMode": "mainResult",
    "inputRequired": false
  },
  "runtime": { "entry": "runtime.js" },
  "permissions": [],
  "settings": [
    { "type": "text", "key": "greeting", "label": "问候文本", "default": "你好" },
    { "type": "number", "key": "count", "label": "数量", "default": 2, "min": 1, "max": 5, "step": 1 },
    { "type": "boolean", "key": "uppercase", "label": "转为大写", "default": false },
    { "type": "select", "key": "style", "label": "显示样式", "default": "plain", "options": [{ "value": "plain", "label": "普通（plain）" }, { "value": "boxed", "label": "方框（boxed）" }] }
  ]
}
