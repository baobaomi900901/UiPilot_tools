{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.note",
  "version": "1.1.5",
  "apiVersion": 1,
  "minimumHostVersion": "0.2.0",
  "name": "Note",
  "description": "在独立窗口中记录、搜索和管理笔记。",
  "supportedPlatforms": ["windows", "macos"],
  "command": {
    "defaultName": "note",
    "summary": "打开笔记窗口",
    "activationMode": "submit",
    "outputMode": "window",
    "inputRequired": false,
    "inputPlaceholder": "直接回车打开笔记"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "window": {
    "entry": "dist/window.html"
  },
  "permissions": ["ui.window"],
  "settings": []
}
