{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-return",
  "version": "1.0.2",
  "apiVersion": 1,
  "minimumHostVersion": "0.2.0",
  "name": "Public Plugin Demo Return",
  "description": "UiPilot public plugin main-result and copy-action reference.",
  "supportedPlatforms": ["windows", "macos"],
  "command": {
    "defaultName": "demo-return",
    "summary": "返回示例文本到主界面",
    "activationMode": "submit",
    "outputMode": "mainResult",
    "inputRequired": true,
    "inputPlaceholder": "请输入信息回车"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "permissions": ["clipboard.write"],
  "settings": []
}
