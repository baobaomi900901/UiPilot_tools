{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.text-snippet",
  "version": "1.1.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.12.0",
  "name": "文本片段",
  "description": "转换文本，显式保存并读取最新片段。",
  "supportedPlatforms": ["windows"],
  "commands": [
    { "id": "transform", "defaultName": "text-snippet", "summary": "转换并保存文本片段", "activationMode": "submit", "outputMode": "mainResult", "inputRequired": true, "inputPlaceholder": "输入要转换的文本" },
    { "id": "latest", "defaultName": "latest-snippet", "summary": "读取最新保存的片段", "activationMode": "submit", "outputMode": "mainResult", "inputRequired": false, "inputPlaceholder": "读取最新片段" }
  ],
  "runtime": { "entry": "dist/runtime.js", "resultActions": true },
  "permissions": ["clipboard.write", "url.open"],
  "settings": []
}
