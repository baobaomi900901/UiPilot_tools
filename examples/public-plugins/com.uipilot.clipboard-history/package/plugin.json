{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.clipboard-history",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.3.3",
  "name": "剪贴板历史",
  "description": "查看并重新粘贴 UiPilot 运行期间保存的最近 20 条剪贴板记录。",
  "supportedPlatforms": ["windows"],
  "command": {
    "defaultName": "clipboard-history",
    "summary": "查看最近的剪贴板记录",
    "activationMode": "submit",
    "outputMode": "panel",
    "inputRequired": false,
    "inputPlaceholder": "最近的剪贴板记录"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "panel": {
    "entry": "dist/panel.html",
    "hostKeys": ["ArrowDown", "ArrowUp", "Tab", "Shift+Tab", "Enter"]
  },
  "permissions": ["ui.panel", "clipboard.history.read", "clipboard.history.paste"],
  "settings": []
}
