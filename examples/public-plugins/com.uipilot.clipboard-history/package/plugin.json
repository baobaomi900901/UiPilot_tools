{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.clipboard-history",
  "version": "1.2.1",
  "apiVersion": 1,
  "minimumHostVersion": "0.17.0",
  "name": "剪贴板历史",
  "description": "查询并复制最近 50 条剪贴板记录。",
  "supportedPlatforms": [
    "windows"
  ],
  "command": {
    "defaultName": "clipboard-history",
    "summary": "查看最近的剪贴板记录",
    "activationMode": "submit",
    "outputMode": "panel",
    "inputRequired": false,
    "inputPlaceholder": "搜索文字或文件名"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "panel": {
    "entry": "dist/panel.html",
    "hostKeys": [
      "ArrowDown",
      "ArrowUp",
      "Tab",
      "Shift+Tab",
      "Delete"
    ],
    "hostKeyFocus": "content"
  },
  "permissions": [
    "ui.panel",
    "clipboard.history.read",
    "clipboard.history.copy"
  ],
  "settings": []
}
