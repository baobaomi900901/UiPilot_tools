{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-panel",
  "version": "1.0.1",
  "apiVersion": 1,
  "minimumHostVersion": "0.3.0",
  "name": "Public Plugin Demo Panel",
  "description": "UiPilot public plugin embedded-panel reference.",
  "supportedPlatforms": ["windows"],
  "command": {
    "defaultName": "demo-panel",
    "summary": "Open the embedded demo panel",
    "activationMode": "submit",
    "outputMode": "panel",
    "inputRequired": false,
    "inputPlaceholder": "Enter text and press Enter"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "panel": {
    "entry": "dist/panel.html"
  },
  "permissions": ["ui.panel"],
  "settings": []
}
