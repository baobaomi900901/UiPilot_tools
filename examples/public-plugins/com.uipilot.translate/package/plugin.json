{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.translate",
  "version": "1.4.3",
  "apiVersion": 1,
  "minimumHostVersion": "0.19.0",
  "name": "翻译",
  "description": "在启动器面板编辑原文、选择语言并使用有道翻译、复制和朗读。",
  "supportedPlatforms": [
    "windows"
  ],
  "command": {
    "defaultName": "translate",
    "summary": "打开翻译面板",
    "activationMode": "submit",
    "outputMode": "panel",
    "inputRequired": false,
    "inputPlaceholder": "输入原文后回车"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "permissions": [
    "selection.read",
    "clipboard.write",
    "network.https",
    "credentials.youdaoTranslation",
    "credentials.baiduOcr",
    "credentials.deepseek",
    "ui.panel",
    "speech.speak"
  ],
  "network": {
    "httpsHosts": [
      "openapi.youdao.com"
    ]
  },
  "settings": [],
  "panel": {
    "runtimeActions": true,
    "entry": "dist/panel.html"
  }
}
