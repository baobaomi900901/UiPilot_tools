{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-recovery",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.5.0",
  "name": "开发恢复演示",
  "description": "独立离线恢复夹具；仅显式 inc 或 seed-v2 写入合成数据。",
  "supportedPlatforms": ["windows"],
  "commands": [{
    "id": "recovery",
    "defaultName": "recovery",
    "summary": "查看计数、递增或触发受控异常",
    "activationMode": "submit",
    "outputMode": "mainResult",
    "inputRequired": false,
    "inputPlaceholder": "status / inc / throw"
  }],
  "runtime": {"entry": "dist/runtime.js"},
  "permissions": [],
  "settings": [{"type":"text","key":"label","label":"只读默认设置","default":"RECOVERY_SETTING_SENTINEL"}]
}
