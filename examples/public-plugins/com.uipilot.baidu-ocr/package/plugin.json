{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.baidu-ocr",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.20.0",
  "name": "百度 OCR",
  "description": "识别主输入框中粘贴的图片，返回可复制的完整文字。",
  "supportedPlatforms": ["windows"],
  "command": {
    "defaultName": "baidu-ocr",
    "summary": "识别图片中的文字",
    "activationMode": "submit",
    "outputMode": "mainResult",
    "inputRequired": true,
    "inputPlaceholder": "粘贴一张图片",
    "inputCapabilities": ["image.ocr"]
  },
  "runtime": { "entry": "dist/runtime.js" },
  "permissions": ["clipboard.write", "credentials.baiduOcr", "network.https"],
  "network": { "httpsHosts": ["aip.baidubce.com"] },
  "settings": []
}
