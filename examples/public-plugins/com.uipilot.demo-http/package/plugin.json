{
  "schemaVersion": 1,
  "pluginId": "com.uipilot.demo-http",
  "version": "1.0.0",
  "apiVersion": 1,
  "minimumHostVersion": "0.3.2",
  "name": "Host HTTPS Demo",
  "description": "Local acceptance fixture for Host-managed public plugin HTTPS.",
  "supportedPlatforms": ["windows"],
  "command": {
    "defaultName": "demo-http",
    "summary": "Exercise Host-managed HTTPS requests",
    "activationMode": "submit",
    "outputMode": "mainResult",
    "inputRequired": false,
    "inputPlaceholder": "get | post TEXT | text TEXT | form TEXT | status 503 | timeout | denied | protected"
  },
  "runtime": {
    "entry": "dist/runtime.js"
  },
  "permissions": ["network.https"],
  "network": {
    "httpsHosts": ["httpbin.org"]
  },
  "settings": []
}
