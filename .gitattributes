# Keep both upstream license copies byte-identical to licenseSha256 in checkouts and archives.
third-party/everything/LICENSE.txt -text whitespace=-blank-at-eol
src-tauri/resources/everything/LICENSE.txt -text whitespace=-blank-at-eol

# Keep Tauri-generated permission files LF-stable on Windows.
src-tauri/permissions/autogenerated/** text eol=lf
src-tauri/Cargo.toml text eol=lf

# Pinned Unicode hashes and generated checks are byte-exact in the TypeScript CLI.
packages/plugin-cli/unicode-data/*.txt text eol=lf
packages/plugin-cli/src/generated/** text eol=lf

# Rust schema generation uses an exact LF comparison.
docs/plugin-sdk/uipilot-plugin-v1.schema.json text eol=lf
packages/plugin-cli/schema/uipilot-plugin-v1.schema.json text eol=lf

# The production CLI archive is compared byte-for-byte with these release sources.
examples/public-plugins/com.uipilot.demo-multi/package/plugin.json text eol=lf
examples/public-plugins/com.uipilot.demo-multi/package/dist/runtime.js text eol=lf
