{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UiPilot_tools VM Instrumented Setup",
  "identifier": "com.uipilot.launcher.vm-instrumented",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run stage:managed-everything:vm"
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/nsis-hooks.nsh",
        "template": "windows/installer.nsi"
      }
    }
  }
}
