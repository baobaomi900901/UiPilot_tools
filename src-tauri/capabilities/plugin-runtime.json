{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin-runtime",
  "description": "Minimal permissions for hidden internal plugin runtimes",
  "windows": ["plugin-runtime-*"],
  "permissions": [
    "allow-plugin-api-call",
    "allow-plugin-network-request",
    "allow-complete-plugin-command",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
