{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot-capability",
  "description": "Host screenshot preview instance only",
  "webviews": ["screenshot"],
  "permissions": [
    "allow-get-screenshot-state",
    "allow-read-screenshot-image",
    "allow-release-screenshot-image",
    "allow-copy-screenshot",
    "allow-save-screenshot",
    "allow-retake-screenshot",
    "allow-close-screenshot",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
