{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin-window-content",
  "description": "One-way ready and update acknowledgement bridge for isolated public plugin content",
  "webviews": ["plugin-content-*"],
  "permissions": [
    "allow-plugin-window-content-ready",
    "allow-plugin-window-content-ack",
    "allow-plugin-window-storage-get",
    "allow-plugin-window-storage-set",
    "allow-plugin-window-storage-remove",
    "allow-plugin-window-timer-get-state",
    "allow-plugin-window-timer-start",
    "allow-plugin-window-timer-stop",
    "allow-plugin-window-timer-reset"
  ]
}
