{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Exact permissions for the local launcher WebView",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "allow-open-find-window",
    "allow-list-public-plugins",
    "allow-prepare-public-plugin-install",
    "allow-commit-public-plugin-install",
    "allow-cancel-public-plugin-install",
    "allow-set-plugin-enabled",
    "allow-set-plugin-effective-name",
    "allow-save-plugin-settings",
    "allow-uninstall-plugin",
    "allow-search-apps",
    "allow-execute-result",
    "allow-list-plugins",
    "allow-install-plugin",
    "allow-reload-plugin",
    "allow-delete-plugin",
    "allow-load-settings",
    "allow-save-settings",
    "allow-save-hotkey",
    "allow-set-theme-preference",
    "allow-hide-launcher",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
