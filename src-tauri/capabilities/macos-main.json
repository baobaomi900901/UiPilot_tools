{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "macos-main",
  "description": "Core launcher commands for the local Apple Silicon main webview",
  "platforms": [
    "macOS"
  ],
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "allow-get-host-capabilities",
    "allow-load-settings",
    "allow-search-apps",
    "allow-execute-result",
    "allow-set-theme-preference",
    "allow-set-web-search-engine",
    "allow-get-macos-login-item",
    "allow-set-macos-login-item",
    "allow-open-macos-login-item-settings",
    "allow-hide-launcher",
    "allow-save-hotkey",
    "allow-set-hotkey-recording",
    "allow-get-launcher-hotkey-status",
    "core:window:allow-start-dragging",
    "allow-list-macos-plugins",
    "allow-prepare-macos-plugin-install",
    "allow-commit-macos-plugin-install",
    "allow-cancel-macos-plugin-install",
    "allow-set-macos-plugin-enabled",
    "allow-set-macos-plugin-permission",
    "allow-save-macos-plugin-settings",
    "allow-save-macos-plugin-command",
    "allow-set-plugin-favorite",
    "allow-remove-macos-plugin"
  ]
}
